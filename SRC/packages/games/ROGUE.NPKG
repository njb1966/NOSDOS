[PACKAGE]
ID=ROGUE
Name=Rogue
Version=1.0
Category=game
Description=Dungeon-crawler that defined the roguelike genre
Author=Epyx
Year=1983
License=freeware
Tags=roguelike dungeon rpg ascii text classic

[HARDWARE]
Memory=256
Sound=none
Mouse=no
VGA=no
CPUSpeed=any
DiskKB=128

[SOURCE]
URL1=http://nosdos.njb1966.com/dist/ROGUE/ROGUE.ZIP
Archive=ROGUE.ZIP
Bytes=47205
Redirect=no

[INSTALL]
InstallDir=C:\GAMES\ROGUE
Extract=yes
Extractor=pkzip
SetPath=no

[POST-INSTALL]
ECHO Rogue installed to %INSTALLDIR%.
ECHO Run %INSTALLDIR%\ROGUE.EXE to start.
ECHO Navigate with numpad. ? for help. Good luck.

[LAUNCHER]
Label=Rogue
Exec=C:\GAMES\ROGUE\ROGUE.EXE
Dir=C:\GAMES\ROGUE
Icon=2

[GAME]
CPUPreset=SLOW477
MemProfile=STD
Notes=Text/CGA mode. No throttle strictly needed but SLOW477 gives authentic feel.
SaveDir=C:\GAMES\ROGUE

[REMOVE]
DELTREE /Y %INSTALLDIR%

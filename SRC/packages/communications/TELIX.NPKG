[PACKAGE]
ID=TELIX
Name=Telix
Version=3.51
Category=communications
Description=Feature-rich shareware terminal emulator with ZMODEM support
Author=deltaComm Development
Year=1992
License=shareware
Tags=terminal modem bbs zmodem serial communications

[HARDWARE]
Memory=384
Sound=speaker
Mouse=yes
VGA=no
CPUSpeed=any
DiskKB=750

[SOURCE]
URL1=https://archive.org/download/telix-3.51/telix351.zip
URL2=https://archive.org/download/msdos_Telix/telix351.zip
Archive=TELIX351.ZIP
Redirect=yes

[INSTALL]
InstallDir=C:\COMM\TELIX
Extract=yes
Extractor=pkzip
SetPath=yes

[POST-INSTALL]
MD %INSTALLDIR%\DL
ECHO Telix 3.51 installed to %INSTALLDIR%.
ECHO Run %INSTALLDIR%\TELIX.EXE to start.
ECHO Downloads will go to %INSTALLDIR%\DL\
ECHO Configure COM port in Alt+O (Settings).

[LAUNCHER]
Label=Telix 3.51
Exec=C:\COMM\TELIX\TELIX.EXE
Dir=C:\COMM\TELIX
Icon=1

[REMOVE]
DELTREE /Y %INSTALLDIR%

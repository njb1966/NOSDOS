[PACKAGE]
ID=FOXPRO
Name=FoxPro
Version=2.0
Category=databases
Description=xBase database with SQL and Rushmore query technology
Author=Fox Software
Year=1991
License=commercial
Tags=database xbase sql programming records rushmore

[HARDWARE]
Memory=512
EMS=512
Sound=none
Mouse=yes
VGA=no
CPUSpeed=any
DiskKB=4500

[SOURCE]
URL1=http://nosdos.njb1966.com/dist/FOXPRO/FOXPRO.ZIP
Archive=FOXPRO.ZIP
Bytes=0
Redirect=no
[INSTALL]
InstallDir=C:\APPS\FOXPRO
Extract=yes
Extractor=pkzip
SetPath=yes

[POST-INSTALL]
MD %INSTALLDIR%\DATA
ECHO FoxPro 2.0 installed to %INSTALLDIR%.
ECHO Run %INSTALLDIR%\FOXPRO.EXE to start.
ECHO EMS memory strongly recommended for large databases.

[LAUNCHER]
Label=FoxPro 2.0
Exec=C:\APPS\FOXPRO\FOXPRO.EXE
Dir=C:\APPS\FOXPRO
Icon=254

[REMOVE]
DELTREE /Y %INSTALLDIR%

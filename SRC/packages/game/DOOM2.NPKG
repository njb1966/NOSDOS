[PACKAGE]
ID=DOOM2
Name=DOOM II: Hell on Earth
Version=1.9
Category=game
Description=id Software's bigger follow-up with new monsters and weapons
Author=id Software
Year=1994
License=commercial
Tags=fps shooter action 3d id software doom

[HARDWARE]
Memory=530
EMS=0
XMS=4096
Sound=sb
Mouse=no
VGA=yes
CPUSpeed=medium
DiskKB=14000

[SOURCE]
URL1=http://nosdos.njb1966.com/dist/DOOM2/DOOM2.ZIP
Archive=DOOM2.ZIP
Bytes=0
Redirect=no
[INSTALL]
InstallDir=C:\GAMES\DOOM2
Extract=yes
Extractor=pkzip
SetPath=no
SetVar=DOOMWADDIR=C:\GAMES\DOOM2

[POST-INSTALL]
MD %INSTALLDIR%\SAVE
ECHO DOOM II installed to %INSTALLDIR%.
ECHO Run %INSTALLDIR%\DOOM2.EXE to start.
ECHO Requires 530KB+ conventional and 4MB XMS. Use NOSMEM /GAME first.

[LAUNCHER]
Label=DOOM II
Exec=C:\GAMES\DOOM2\DOOM2.EXE
Dir=C:\GAMES\DOOM2
Icon=2

[GAME]
CPUPreset=SLOW33
MemProfile=GAME
SoundEnv=BLASTER=A220 I5 D1 H5 P330 T6
MusicExt=OPL
Notes=Requires 530KB+ conventional and 4MB XMS. Needs full commercial WAD.
SaveDir=C:\GAMES\DOOM2\SAVE

[REMOVE]
DELTREE /Y %INSTALLDIR%

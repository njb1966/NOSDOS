[PACKAGE]
ID=GALAXY
Name=Galaxy Write
Version=4.0
Category=wordprocessing
Description=Lightweight freeware word processor with spell checker
Author=Apogee Software
Year=1992
License=freeware
Tags=word processor text editor writing

[HARDWARE]
Memory=384
Sound=none
Mouse=yes
VGA=no
CPUSpeed=any
DiskKB=512

[SOURCE]
URL1=http://nosdos.njb1966.com/dist/GALAXY/GALAXY.ZIP
Archive=GALAXY.ZIP
Bytes=0
Redirect=no
[INSTALL]
InstallDir=C:\APPS\GALAXY
Extract=yes
Extractor=pkzip
SetPath=yes

[POST-INSTALL]
ECHO Galaxy Write installed to %INSTALLDIR%.
ECHO Run: GALAXY.EXE

[LAUNCHER]
Label=Galaxy Write 4.0
Exec=C:\APPS\GALAXY\GALAXY.EXE
Dir=C:\APPS\GALAXY
Icon=254

[REMOVE]
DELTREE /Y %INSTALLDIR%

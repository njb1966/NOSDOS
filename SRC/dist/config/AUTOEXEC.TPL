@ECHO OFF
REM NOS-DOS AUTOEXEC.BAT - Generated by NOS-DETECT on first boot.
REM Do not edit by hand - re-run DETECT.EXE to regenerate.
SET PROMPT=$P$G
SET PATH=C:\;C:\NOS\SYSTEM;C:\NOS\SHELL;C:\APPS
{{MOUSE_LINE}}
{{BLASTER_LINE}}
LH C:\NOS\SYSTEM\PCNTPK.COM INT=0x60
{{PKT_DRIVER_LINE}}
REM Launch NOS-SHELL
C:\NOS\SHELL\SHELL.EXE

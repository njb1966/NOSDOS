# Build output
out/

# Compiled object files and binaries (regenerated by compile.py)
src/*/obj/
src/*/bin/

# Downloaded third-party dependencies (regenerated by fetch_deps.py)
dist/thirdparty/

# Python cache
__pycache__/
*.pyc

# Stray DOS binaries in project root (copies of dist/thirdparty files)
/AUTOEXEC.BAT
/COMMAND.COM
/CONFIG.SYS
/JEMMEX.EXE
/KERNEL.SYS
/OAKCDROM.SYS
/SHSUCDX.COM
/SYS.COM
/oakcdrom.sys

# Stray build artefacts in project root
/floppy.img
/formats=ZIP
/wget-log

# Editor / OS noise
*.swp
.DS_Store
Thumbs.db

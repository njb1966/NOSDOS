# Build output (binaries and images)
out/
# But keep launch scripts and assembler sources in out/
!out/*.sh
!out/*.bat
!out/*.asm

# Compiled object files and binaries (regenerated by compile.py)
src/*/obj/
src/*/bin/

# Downloaded third-party dependencies (regenerated by fetch_deps.py)
dist/thirdparty/

# Python cache
__pycache__/
*.pyc

# Stray DOS binaries in project root (copies of dist/thirdparty files)
/AUTOEXEC.BAT
/COMMAND.COM
/CONFIG.SYS
/JEMMEX.EXE
/KERNEL.SYS
/OAKCDROM.SYS
/GCDROM.SYS
/SHSUCDX.COM
/SYS.COM
/oakcdrom.sys
/gcdrom.sys

# Stray build artefacts in project root
/floppy.img
/formats=ZIP
/wget-log
/PKUNZIP.IMG

# Editor / OS noise
*.swp
.DS_Store
Thumbs.db
